# Path to customer support document
DATA_PATH=data/support_kb.txt

# Vector index persistence directory
INDEX_PATH=faiss_index

# Chunking Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval Hyperparameters
TOP_K=3

# Local Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional LLM API Keys (If left empty, the application runs using the built-in offline educational engine)
OPENAI_API_KEY=
GOOGLE_API_KEY=
